# 行尾约定：Windows 批处理必须 CRLF，否则 cmd 解析异常；macOS/Linux 脚本必须 LF。
* text=auto
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.command  text eol=lf
*.sh       text eol=lf
*.ps1      text eol=crlf
*.mjs      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
